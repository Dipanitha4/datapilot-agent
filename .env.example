# ─── LLM Configuration ───────────────────────────────────────────────────────
# Get free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama fallback (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/travel_ai
LANGGRAPH_CHECKPOINT_DB=postgresql://postgres:your_postgres_password_here@localhost:5432/travel_ai


# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── LangSmith Monitoring ────────────────────────────────────────────────────
# Get free API key at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=travel-ai-agent

# ─── Observability (Jaeger) ──────────────────────────────────────────────────
JAEGER_HOST=localhost
JAEGER_PORT=4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=travel-ai-agent

# ─── API Configuration ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your_secret_key_here

# ─── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Human Approval ──────────────────────────────────────────────────────────
# Refund amount above this requires human approval
APPROVAL_THRESHOLD_USD=500
